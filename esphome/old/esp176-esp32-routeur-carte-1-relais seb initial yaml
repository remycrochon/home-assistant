substitutions:
  device_name: "esp176-esp32-routeur-1r"
  friendly_name: esp176
  adress_ip: "192.168.0.176"
  time_timezone: "Europe/Paris"

  name: jsy194
  current_address: '1'
  current_baud_rate: '38400'
  updates: 2s
  modbus_throttle: 1000ms
  offset_select: '2'  
  
esphome:
  name: ${device_name}
 
esp32:
  board: esp32dev
  framework:
    type: arduino
    version: 2.0.11 #2.0.5 2.0.9
    platform_version: 6.4.0 #4.4.0 6.2.0   

wifi:
  networks:
    - ssid: !secret wifi
      password: !secret mdpwifi
  reboot_timeout: 5min

  manual_ip:
    static_ip: ${adress_ip}
    gateway: 192.168.0.254
    subnet: 255.255.255.0

# Enable logging
logger:
  baud_rate: 0
  level: debug
#  logs:
#    modbus.component: INFO


web_server:
  port: 80
api:
ota:
# Protocole afficheur


external_components:
#  - source: "github://SeByDocKy/myESPhome/"
  - source: mes_composants
    components: [jsy194]
    refresh: 0s

uart:
  - id: uart_0
    tx_pin: 17
    rx_pin: 16 
    baud_rate: ${current_baud_rate}
    stop_bits: 1 # 2 for ESP32, 1 for ESP8266
    debug:
      direction: BOTH
      dummy_receiver: false
      after:
        timeout: 150ms
      sequence:
        - lambda: |-
            UARTDebug::log_string(direction, bytes);  //Still log the data

text_sensor:
  - platform: template
    name: "Raw String"
    id: "rawString"

modbus:
   id: modbus_0
   uart_id: uart_0
   send_wait_time: ${modbus_throttle}

