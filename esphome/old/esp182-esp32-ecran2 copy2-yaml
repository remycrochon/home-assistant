    internal: true
  - platform: homeassistant
    id: pv1_power
    entity_id: sensor.mp2_mppt1_puissance_production_pv
    unit_of_measurement: W
    internal: true
  - platform: homeassistant
    id: pv2_power
    entity_id: sensor.envoy_122103023124_current_power_production
    unit_of_measurement: W
    internal: true

  # House (Essential Load)
  - platform: homeassistant
    id: house_power
    entity_id: sensor.mp2_conso_out1_mqtt
    unit_of_measurement: W
    internal: true
  - platform: homeassistant
    id: house_energy_day
    entity_id: sensor.mp2_energy_conso_ac_l1_jour
    unit_of_measurement: kWh
    internal: true
  - platform: homeassistant
    id: load1_power
    entity_id: sensor.pzem_pisc_puissance
    unit_of_measurement: W
    internal: true
  - platform: homeassistant
    id: load2_power
    entity_id: sensor.pc_onduleur_eaton_puissance
    unit_of_measurement: W
    internal: true
  - platform: homeassistant
    id: load3_power
    entity_id: sensor.pzem_cuisine_puissance
    unit_of_measurement: W
    internal: true
  - platform: homeassistant
    id: load4_power
    entity_id: sensor.ecocompteur_vmc_niv0
    unit_of_measurement: W
    internal: true

  # Battery
  - platform: homeassistant
    id: battery_soc
    entity_id: sensor.mp2_soc_mqtt
    unit_of_measurement: "%"
    internal: true
  - platform: homeassistant
    id: battery_power
    entity_id: sensor.mp2_pu_batteries_par_mqtt
    unit_of_measurement: W
    internal: true
  - platform: homeassistant
    id: battery_voltage
    entity_id: sensor.mp2_tension_batteries_par_mqtt
    unit_of_measurement: V
    internal: true
  - platform: homeassistant
    id: battery_charge_day
    entity_id: sensor.mp2_energy_charge_batteries_jour
    unit_of_measurement: kWh
    internal: true
  - platform: homeassistant
    id: battery_discharge_day
    entity_id: sensor.mp2_energy_decharge_batteries_jour
    unit_of_measurement: kWh
    internal: true

  # Grid
  - platform: homeassistant
    id: grid_power
    entity_id: sensor.mp2_conso_ac_l1
    unit_of_measurement: W
    internal: true
  - platform: homeassistant
    id: grid_import_day
    entity_id: sensor.mp2_energie_soutiree_du_reseau_par_jour
    unit_of_measurement: kWh
    internal: true
  - platform: homeassistant
    id: grid_export_day
    entity_id: sensor.mp2_energie_injectee_ds_reseau_par_jour
    unit_of_measurement: kWh
    internal: true

  # Non-essential Loads (Hors MP2)
  - platform: homeassistant
    id: nonessential_power
    entity_id: sensor.pu_ecs_clim_pac
    unit_of_measurement: W
    internal: true
  - platform: homeassistant
    id: nonessential_load1
    entity_id: sensor.ecocompteur_ecs
    unit_of_measurement: W
    internal: true
  - platform: homeassistant
    id: nonessential_load2
    entity_id: sensor.ecocompteur_clim
    unit_of_measurement: W
    internal: true
  - platform: homeassistant
    id: nonessential_load3
    entity_id: sensor.ecocompteur_pac
    unit_of_measurement: W
    internal: true

font:
  - file: "fonts/materialdesignicons-webfont.ttf"
    id: icon_font
    size: 32
    glyphs: [ "\U000F0F05", "\U000F02DC", "\U000F0590", "\U000F0E7E", "\U000F04B2" ] # Sun, House, Battery, Grid, Oven
  - file: "fonts/arial.ttf"
    id: text_font
    size: 18


display:
  - platform: st7701s
    id: my_display
    update_interval: never
    auto_clear_enabled: False
    spi_mode: MODE3
    data_rate: 2MHz
    color_order: RGB
    invert_colors: False
    dimensions:
      width: 480
      height: 480
    cs_pin: 39
    de_pin: 18
    hsync_pin: 16
    vsync_pin: 17
    pclk_pin: 21
    pclk_frequency: 12MHz
    pclk_inverted: False
    hsync_pulse_width: 8
    hsync_front_porch: 10
    hsync_back_porch: 20
    vsync_pulse_width: 8
    vsync_front_porch: 10
    vsync_back_porch: 10
    init_sequence:
      - 1
      # Custom sequences are an array, first byte is command, the rest are data.
      - [0xFF, 0x77, 0x01, 0x00, 0x00, 0x10] # CMD2_BKSEL_BK0
      - [0xCD, 0x00] # disable MDT flag
    data_pins:
      red:
        - 11 #r1
        - 12 #r2
        - 13 #r3
        - 14 #r4
        - 0 #r5
      green:
        - 8 #g0
        - 20 #g1
        - 3 #g2
        - 46 #g3
        - 9 #g4
        - 10 #g5
      blue:
        - 4 #b1
        - 5 #b2
        - 6 #b3
        - 7 #b4
        - 15 #b5

lvgl:
  id: lvgl_comp
  displays:
    - my_display
  touchscreens:
    - touchscreen_id: my_touchscreen
  widgets:
    # Solar (top left)
    - obj:
        id: solar_box
        x: 10
        y: 10
        width: 140
        height: 110
        pad_all: 5
        border_width: 2
        border_color: 0xFFFFFF
        bg_color: 0x333333
